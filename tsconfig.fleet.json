{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2020",
    "outDir": ".fleet-dist",
    "rootDir": ".",
    "noEmit": false,
    "incremental": false,
    "isolatedModules": true,
    "plugins": []
  },
  "include": [
    "src/server/fleet-http.ts",
    "src/server/edge-agent.ts",
    "src/core/fleet/config.ts",
    "src/core/bench/edge-choke.ts",
    "src/core/distributed/worker.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    ".fleet-dist"
  ]
}
