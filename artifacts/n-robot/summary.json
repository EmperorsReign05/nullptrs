{
  "schema": 1,
  "subject": "N-robot generalization: one fleet config drives controllers, ROS namespaces, Nav2 stacks, DDS peers and executors",
  "fleetConfig": "config/fleet.json, overridable per run with FLEET_CONFIG",
  "launchAnyN": "npm run fleet:n -- --robots <N>   (software fleet over real Fast DDS)\nnpm run fleet:n:nav2 -- --robots <N>  (same fleet through real Nav2)",
  "maxN": {
    "nav2ContinuousExecution": 6,
    "softwareFastDds": 8,
    "ownershipQuorumTests": 8,
    "note": "Nav2 N=7 and N=8 start every controller/stack/peer with zero safety violations but complete no task: the serialized lockstep commit makes one logical tick span N real Nav2 moves, which exceeds the 6-tick peer liveness window. Changing that constant is an ownership-semantics change and is out of scope for this pass."
