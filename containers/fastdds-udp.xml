<?xml version="1.0" encoding="UTF-8" ?>
<!-- UDP-only avoids accidental same-host shared-memory evidence. No discovery server. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor><transport_id>fleet_udp</transport_id><type>UDPv4</type></transport_descriptor>
  </transport_descriptors>
  <participant profile_name="fleet_peer" is_default_profile="true">
    <rtps>
      <userTransports><transport_id>fleet_udp</transport_id></userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
